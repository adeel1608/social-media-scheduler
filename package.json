{
  "name": "social-media-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single-owner, self-hosted Instagram, TikTok, and YouTube scheduler",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @scheduler/web dev",
    "dev:worker": "corepack pnpm --filter @scheduler/worker dev",
    "build": "corepack pnpm -r --if-present build",
    "build:verify": "node scripts/verify-production-build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "corepack pnpm --filter @scheduler/web test:e2e",
    "db:validate": "node scripts/validate-migrations.mjs",
    "db:test": "supabase test db",
    "db:integration": "node scripts/run-disposable-integration.mjs",
    "db:verify:production": "node scripts/verify-production-migration.mjs",
    "setup-doctor": "node scripts/setup-doctor.mjs",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "audit": "corepack pnpm audit --audit-level high",
    "audit:ci": "node scripts/audit-with-retry.mjs",
    "deploy:validate": "node scripts/validate-deploy-config.mjs",
    "production:inspect": "node scripts/inspect-public-deployment.mjs",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build:verify && corepack pnpm db:validate && corepack pnpm secrets:scan"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "smol-toml": "1.8.0",
    "supabase": "2.117.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
