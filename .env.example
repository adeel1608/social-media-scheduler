# Browser-safe application configuration
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:8787
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Explicitly labelled sample data for local UI development only. Never enable in production.
VITE_DEMO_MODE=true

# Installation ownership and notifications
APP_URL=http://localhost:5173
OWNER_EMAIL=owner@example.com
NOTIFICATION_EMAIL=owner@example.com
TIMEZONE=Australia/Melbourne
LIVE_TEST_CONFIRM=false
ENVIRONMENT=development

# Supabase. The service role key is server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret

# 32 random bytes, base64 encoded. Generate locally; never commit the result.
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
TOKEN_ENCRYPTION_KEY_VERSION=v1

# Cloudflare and private R2
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_API_TOKEN=replace-with-deployment-token
R2_BUCKET_NAME=social-scheduler-media
R2_ACCESS_KEY_ID=replace-with-r2-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret
R2_PUBLIC_DELIVERY_HOST=https://media.example.com

# Resend failure notifications
RESEND_API_KEY=re_replace-with-api-key
RESEND_FROM=Scheduler Alerts <alerts@example.com>

# Instagram API with Instagram Login
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
META_REDIRECT_URI=http://localhost:8787/api/oauth/instagram/callback
META_GRAPH_VERSION=v23.0
META_APP_REVIEW_APPROVED=false

# TikTok Login Kit and Content Posting API
TIKTOK_CLIENT_KEY=replace-with-client-key
TIKTOK_CLIENT_SECRET=replace-with-client-secret
TIKTOK_REDIRECT_URI=http://localhost:8787/api/oauth/tiktok/callback
TIKTOK_CONTENT_POSTING_AUDITED=false

# Google OAuth, YouTube Data API v3, and YouTube Analytics API
GOOGLE_CLIENT_ID=replace-with-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8787/api/oauth/youtube/callback
YOUTUBE_API_AUDIT_APPROVED=false
